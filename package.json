{
  "name": "tornscape-tabletop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"npm:dev:front\" \"npm:dev:back\"",
    "dev:front": "vite",
    "dev:back": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:seed": "prisma db seed",
    "db:studio": "node scripts/prisma-studio.mjs",
    "api:smoke": "node scripts/api-smoke.mjs",
    "catalog:report": "node scripts/torn-catalog-report.mjs",
    "browser": "node scripts/browser.mjs",
    "browser:open": "node scripts/browser.mjs open",
    "browser:see": "node scripts/browser.mjs see",
    "browser:shot": "node scripts/browser.mjs screenshot",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
